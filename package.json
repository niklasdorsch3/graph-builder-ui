{
  "name": "graph-builder-ui",
  "version": "1.0.0",
  "description": "A React component library for building and visualizing JSON-based graphs with animated layouts",
  "type": "module",
  "main": "./dist/graph-builder-ui.umd.js",
  "module": "./dist/graph-builder-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/graph-builder-ui.es.js",
      "require": "./dist/graph-builder-ui.umd.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d demo-dist"
  },
  "keywords": [
    "react",
    "graph",
    "visualization",
    "ui",
    "component",
    "layout",
    "animation",
    "framer-motion"
  ],
  "author": "Niklas Dorsch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/niklasdorsch3/graph-builder-ui.git"
  },
  "homepage": "https://niklasdorsch3.github.io/graph-builder-ui",
  "bugs": {
    "url": "https://github.com/niklasdorsch3/graph-builder-ui/issues"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^12.23.24",
    "gh-pages": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.10"
  }
}
